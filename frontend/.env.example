# ===========================================================================
# JC Security — Variables de entorno del FRONTEND
# Copia este archivo a .env.local y rellena los valores cuando estén listos.
# Todas las variables expuestas al navegador DEBEN empezar con VITE_.
# ===========================================================================

# Fuente de datos del catálogo. Valores posibles:
#   mock     -> datos de muestra incluidos en el frontend (por defecto)
#   supabase -> lee directo de Supabase con la anon key (Opción A)
#   api      -> consume la API del backend de Claude (Opción B)
VITE_DATA_SOURCE=mock

# --- Opción A: Supabase directo (lo configura/aprueba Claude) ---
# PENDIENTE: Claude debe crear el proyecto Supabase y las políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Opción B: API del backend de Claude ---
# PENDIENTE: URL base de la API cuando Claude la despliegue.
VITE_API_BASE_URL=

# --- Agente de IA (FAQ) ---
# PENDIENTE: endpoint del agente. Lo define Claude. No inventar.
VITE_AI_CHAT_ENABLED=false

# --- Contacto ---
# PENDIENTE: número oficial de WhatsApp en formato internacional SIN "+",
# espacios ni guiones. Ej: 521234567890. Dejar vacío hasta confirmarlo.
VITE_WHATSAPP_NUMBER=
