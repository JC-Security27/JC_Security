# ===========================================================================
# JC Security — .gitignore raíz (cubre frontend + backend)
# ===========================================================================

# Dependencias
node_modules/
**/node_modules/

# Builds / salidas
dist/
build/
.vercel/
.output/
**/dist/
**/build/

# Variables de entorno con secretos (NUNCA subir)
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Logs temporales de build (no versionar)
build-out.txt
build-log.txt
tsc-log.txt
tsc2.txt

# Sistema / editor
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
.idea/

# Python (por si el backend lo usa)
__pycache__/
*.py[cod]
.venv/
venv/

# Supabase local
.branches/
.temp/
